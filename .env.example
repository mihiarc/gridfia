# GridFIA Cloud Storage Configuration
# Copy this file to .env and fill in your values

# Cloud storage backend: b2 (Backblaze B2), s3 (AWS S3), or local
GRIDFIA_CLOUD__BACKEND=b2

# Bucket name for cloud storage
GRIDFIA_CLOUD__BUCKET=your-bucket-name

# Public URL for accessing files (optional, for public buckets)
GRIDFIA_CLOUD__PUBLIC_URL=https://your-public-url.com

# S3-compatible endpoint URL (for B2 or other S3-compatible services)
GRIDFIA_CLOUD__ENDPOINT_URL=https://s3.your-region.backblazeb2.com

# Cloud storage region
GRIDFIA_CLOUD__REGION=us-east-005

# For authenticated access (not needed for public buckets):
# GRIDFIA_CLOUD__ACCESS_KEY=your-access-key
# GRIDFIA_CLOUD__SECRET_KEY=your-secret-key
